# ==============================================================================
# AI Cognitive Engagement & Memory Assistance Platform (MindBridge)
# Environment Configuration Template (.env.example)
#
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# NEVER COMMIT REAL CREDENTIALS OR .env FILES TO GIT (Engineering Rules §3).
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Core Runtime
# ------------------------------------------------------------------------------
APP_NAME="MindBridge Cognitive Platform"
APP_ENV="development"                  # development | testing | staging | production
DEBUG=true
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Backend Server & Networking (apps/api)
# ------------------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=8000
# JSON array of permitted origins for CORS middleware
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_USER="mindbridge_user"
POSTGRES_PASSWORD="mindbridge_dev_password"
POSTGRES_DB="mindbridge_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Async connection string for FastAPI / SQLAlchemy async engine
DATABASE_URL="postgresql+asyncpg://mindbridge_user:mindbridge_dev_password@localhost:5432/mindbridge_db"

# Synchronous connection string for Alembic database migrations
SYNC_DATABASE_URL="postgresql+psycopg2://mindbridge_user:mindbridge_dev_password@localhost:5432/mindbridge_db"

# ------------------------------------------------------------------------------
# Redis Cache & Ephemeral State
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Security, Authentication & JWT (Engineering Rules §6)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret. MUST be changed in production.
JWT_SECRET_KEY="dev_insecure_jwt_secret_change_me_in_production_min_32_bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# AI Gateway & LLM Provider (Technology Stack §2, ADR-008, ADR-009)
# ------------------------------------------------------------------------------
# Supported providers: mock | openai | anthropic | gemini
AI_GATEWAY_PROVIDER="mock"
AI_GATEWAY_API_KEY="dev_dummy_api_key"
AI_CHAT_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# Object Storage (S3-Compatible / MinIO - ADR-007)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="mindbridge-media"
S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_ENV="development"
